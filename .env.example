# =============================================================================
# FactLens — environment configuration
# =============================================================================
# Copy to .env and adjust. docker compose reads this file automatically; every
# value also has a working development default in docker-compose.yml, so the
# stack starts without a .env at all.
#
#   cp .env.example .env
#
# Never commit .env. The defaults are development values and MUST be changed
# before any deployment that is reachable from the internet.
#
# Inside Docker the database and Redis URLs are assembled by docker-compose.yml
# from the values below; they are not set here.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — one database holds all persistent data
# -----------------------------------------------------------------------------
# Changing these after the first start needs a fresh volume:
#   docker compose down -v
POSTGRES_USER=factlens_admin
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=factlens_db

# -----------------------------------------------------------------------------
# Host ports (the gateway is the only one the browser needs)
# -----------------------------------------------------------------------------
FACTLENS_PORT=80
# Published on 127.0.0.1 only, for API docs (/docs) and database inspection.
# They clash with the Windows .bat stack: stop that before `docker compose up`.
IDENTITY_HOST_PORT=8001
RUMOUR_HOST_PORT=8002
SCAM_HOST_PORT=8003
IMAGE_HOST_PORT=8004
POSTGRES_HOST_PORT=5433

# -----------------------------------------------------------------------------
# Worker sizing — bounded by RAM: each rumour worker process holds its own
# BanglaVerify copy (~1 GB), the scam worker one ScamNet-BN copy (~2.3 GB).
# -----------------------------------------------------------------------------
RUMOUR_WORKER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost. 12 is ~250ms on a modest VPS; lower it only if login latency hurts.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Model registry
# -----------------------------------------------------------------------------
# The manifest the providers read at application start. An entry with no
# artifact makes its provider report unavailable and its module degrade to
# non-ML signals, marking scans PARTIAL — the designed degraded mode.
MODEL_REGISTRY_PATH=/models/registry.json

# -----------------------------------------------------------------------------
# BanglaVerify v2 (Rumor Scanner model, PyTorch)
# -----------------------------------------------------------------------------
# Weights, tokenizer, temperatures and thresholds live in models/banglaverify
# (outside git). Docker: the read-only mount at /models/banglaverify.
BANGLAVERIFY_MODEL_DIR=/models/banglaverify
BANGLAVERIFY_DEVICE=cpu
# Past this, the scan continues on the evidence pipeline and is marked PARTIAL.
BANGLAVERIFY_TIMEOUT_SECONDS=10
# Optional cap on torch CPU threads; blank or 0 for torch's default.
BANGLAVERIFY_NUM_THREADS=
# Verdict rule: at or above this confidence the model decides alone; below it
# the web evidence decides. Claims with আজকে / গতকাল / এই মাসে … add the raise.
BANGLAVERIFY_DECISIVE_CONFIDENCE=0.80
BANGLAVERIFY_TEMPORAL_BAR_RAISE=0.10

# -----------------------------------------------------------------------------
# ScamNet-BN (Scam Alert model, PyTorch)
# -----------------------------------------------------------------------------
# Weights live outside git. Locally: models/scamnet (the default). Docker: the
# read-only mount at /models/scamnet. Thresholds, temperature and labels come
# only from scamnet_config.json in that folder.
SCAMNET_MODEL_DIR=/models/scamnet
# cuda when available, otherwise cpu.
SCAMNET_DEVICE=cpu
# Ensemble members to load: ~2.3 GB RAM each on CPU. Default 1 on CPU, 3 on GPU.
SCAMNET_MAX_MODELS=1
# Past this, the scan continues without the model and is marked PARTIAL.
SCAMNET_TIMEOUT_SECONDS=10
# Optional cap on torch CPU threads; blank for torch's default.
SCAMNET_NUM_THREADS=
# Skip the Hugging Face Hub lookup; the provider has the encoder config built in.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# -----------------------------------------------------------------------------
# Scan time budgets (seconds)
# -----------------------------------------------------------------------------
# Exceeding these moves a scan to TIMEOUT, which is retryable and distinct
# from FAILED.
RUMOR_TIME_LIMIT_S=120
SCAM_TIME_LIMIT_S=60
IMAGE_TIME_LIMIT_S=90

# -----------------------------------------------------------------------------
# Rate limiting — each scan triggers model inference and external search
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_S=3600
RUMOR_RATE_LIMIT_USER=40
RUMOR_RATE_LIMIT_IP=20
SCAM_RATE_LIMIT_USER=60
SCAM_RATE_LIMIT_IP=30
IMAGE_RATE_LIMIT_USER=40
IMAGE_RATE_LIMIT_IP=20

# -----------------------------------------------------------------------------
# Uploads and retention
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
IMAGE_UPLOAD_DIR=/app/var/uploads
# Users upload screenshots of private conversations. Original bytes are deleted
# after this window; only derived analysis fields are kept.
IMAGE_RETENTION_HOURS=24

# -----------------------------------------------------------------------------
# OCR — the shared input layer
# -----------------------------------------------------------------------------
# EasyOCR downloads its detector and recogniser weights on first use (~100 MB).
# Set EASYOCR_DOWNLOAD=false on an air-gapped host; the provider then falls back
# to Tesseract ben+eng and reports which engine actually read the image.
EASYOCR_DOWNLOAD=true
EASYOCR_GPU=false

# -----------------------------------------------------------------------------
# URL reputation (optional)
# -----------------------------------------------------------------------------
# Leave blank to run on the structural checks alone. When blank, results record
# reputation_source="not_configured" rather than implying a clean verdict.
# Only the URL is ever sent — never the message body.
URL_REPUTATION_ENDPOINT=
URL_REPUTATION_API_KEY=
URL_ANALYSIS_TIMEOUT_S=6
URL_ANALYSIS_MAX_REDIRECTS=8

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Blank routes through the nginx gateway on the same origin. Set an absolute
# URL only when the frontend is served from a different host than the API.
VITE_API_URL=
